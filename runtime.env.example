# Copy to runtime.env; keep it private (chmod 600). Never commit the real key.
# start.sh sources this as a trusted shell file. Use single quotes for values.
QUASAR_LLM_API_KEY='REPLACE_WITH_YOUR_API_KEY'
# Model and endpoint belong in config.json; these optional overrides are useful
# when using an existing OpenAI-compatible gateway instead of direct Gemini:
# QUASAR_LLM_BASE_URL='https://gateway.example.invalid/v1'
# QUASAR_LLM_MODEL='YOUR_GATEWAY_MODEL'
# Leave QUASAR_HOME_MCP_URL unset unless intentionally enabling Home Assistant.
